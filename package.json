{
  "name": "@dumbo-ai/dsh-acp",
  "version": "0.6.0",
  "description": "DeepSeek Harness official ACP with default plans, titles and tool presentation",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dsh-acp": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "assets/",
    "examples/",
    "README.md",
    "README.en.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "prepack": "pnpm check"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.4",
    "@deepseek-ai/dsh-acp": "0.2.1-rc.4",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.4",
    "@deepseek-ai/dsh-session": "0.2.1-rc.4",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.4",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.4",
    "@deepseek-ai/dsh-session-projection-cache": "0.2.1-rc.4",
    "@deepseek-ai/dsh-session-title": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tool-todo": "0.2.1-rc.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-rc.4",
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.13",
    "eslint": "10.8.1",
    "globals": "17.10.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.7.0"
}
